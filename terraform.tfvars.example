aws_region    = "ap-south-1"
project       = "demo"
environment   = "dev"
owner         = "devops-team"

instance_name  = "web-server"
instance_type  = "t3.micro"
ubuntu_version = "24.04"

# Networking
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
enable_nat_gateway   = false

# Access: leave empty to use SSM Session Manager only (recommended)
allowed_ssh_cidrs = []
# allowed_ssh_cidrs = ["203.0.113.10/32"]   # your own IP, never 0.0.0.0/0
# key_name          = "my-keypair"

# Storage
root_volume_size = 20
data_volume_size = 0   # set e.g. 50 for an extra encrypted data disk mounted at /data
