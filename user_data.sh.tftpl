#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

# Patch the OS
apt-get update -y
apt-get upgrade -y

# Base packages (nginx is a placeholder workload - replace as needed)
apt-get install -y nginx unattended-upgrades curl jq

# Hostname
hostnamectl set-hostname "${hostname}"

# Make sure SSM agent is running (preinstalled as a snap on Ubuntu AMIs)
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || true

# Enable automatic security updates
dpkg-reconfigure -f noninteractive unattended-upgrades

%{ if data_volume_enabled ~}
# Format and mount the extra data volume (idempotent)
DEVICE="/dev/nvme1n1"
for i in $(seq 1 30); do
  [ -b "$DEVICE" ] && break
  sleep 2
done

if [ -b "$DEVICE" ]; then
  if ! blkid "$DEVICE" >/dev/null 2>&1; then
    mkfs.ext4 -L data "$DEVICE"
  fi
  mkdir -p /data
  UUID=$(blkid -s UUID -o value "$DEVICE")
  grep -q "$UUID" /etc/fstab || echo "UUID=$UUID /data ext4 defaults,nofail 0 2" >> /etc/fstab
  mount -a
fi
%{ endif ~}

systemctl enable --now nginx
