aws_region  = "ap-south-1"
project     = "demo"
environment = "dev"

# From the vpc-terraform project: terraform output vpc_id / public_subnet_ids / private_subnet_ids
vpc_id             = "vpc-0123456789abcdef0"
public_subnet_ids  = ["subnet-0aaa1111bbb22222a", "subnet-0ccc3333ddd44444b"]
private_subnet_ids = ["subnet-0eee5555fff66666a", "subnet-0111777788889999b"]

alb_name = "web"
internal = false

# HTTPS: paste an ACM certificate ARN (same region). Leave commented for HTTP-only testing.
# certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

allowed_ingress_cidrs      = ["0.0.0.0/0"]
enable_deletion_protection = false # true in prod
enable_access_logs         = true

app_port          = 80
health_check_path = "/"

instance_type        = "t3.micro"
asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 4
